# Copy this file to ".env" and fill in real values.
# .env is git-ignored so credentials never get committed.

# OrangeHRM demo target
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com/web/index.php/auth/login

# OrangeHRM login credentials are intentionally NOT configured here.
# They are mandatory runtime input entered into the dashboard form on every
# run (Username + Password fields) and are never sourced from this file,
# from config.py, or from any other executable default.

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_DEBUG=True
FLASK_PORT=5000

# Selenium
RUN_HEADLESS=True
IMPLICIT_WAIT_SECONDS=10
EXPLICIT_WAIT_SECONDS=15
